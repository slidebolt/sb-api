# Copy to .env.local and fill in your local values.
SB_API_PORT=29011
SB_API_BASE_URL=http://127.0.0.1:29011
# Optional explicit override for the HTTP bind address.
SB_API_LISTEN_ADDR=127.0.0.1:29011
# Optional explicit host that sb-api advertises to other services.
SB_API_HTTP_URL=127.0.0.1
# Optional manager read-only status endpoint used by /runtime/components.
SB_MANAGER_STATUS_URL=http://127.0.0.1:29010
